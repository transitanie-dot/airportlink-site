# ============================================================
# OS CABEÇALHOS DE SEGURANÇA
#
# O site é servido pelo Render como ficheiros estáticos — não há
# servidor onde pôr cabeçalhos em código. Vão aqui, e o Render
# aplica-os a cada resposta.
#
# Escritos à mão e explicados. Uma configuração que ninguém
# entende é uma que se desliga à primeira coisa que parte.
# ============================================================

/*
  # Só HTTPS, e o browser lembra-se por um ano.
  #
  # Sem isto, quem escreva "airportlink.app" na barra faz o
  # primeiro pedido em HTTP — e nesse pedido vai o cookie de
  # sessão em claro, numa rede de aeroporto onde qualquer um o lê.
  #
  # Sem preload: entrar na lista do Chrome é irreversível na
  # prática, e não se faz com um domínio de dois meses.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # O browser não adivinha o tipo do ficheiro.
  #
  # Um upload com HTML dentro mas extensão .jpg não é servido como
  # página — e portanto não corre JavaScript no nosso domínio.
  X-Content-Type-Options: nosniff

  # Ninguém nos põe num iframe.
  #
  # É o ataque de sobrepor um botão invisível sobre o nosso: a
  # pessoa julga que clica noutra coisa e reserva uma viagem.
  X-Frame-Options: DENY

  # O endereço não viaja para fora.
  #
  # Um link de /myaccount?booking=AL123 para um site externo levava
  # a referência da reserva no Referer. Com esta regra, sites
  # externos recebem só o domínio.
  Referrer-Policy: strict-origin-when-cross-origin

  # Nada de câmara, microfone ou localização.
  #
  # Não usamos nenhum. Declará-lo impede que um script de
  # terceiros os peça em nosso nome — e o pedido apareceria com o
  # nosso nome na caixa do browser.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)

  # ------------------------------------------------------------
  # O QUE A PÁGINA PODE CARREGAR
  #
  # O 'unsafe-inline' no script-src é uma cedência real: há onze
  # blocos <script> dentro do HTML, e tirá-los seria reescrever as
  # páginas todas.
  #
  # Isso torna o CSP menos útil contra XSS — mas continua a servir
  # para o resto: impede que um script injetado chame um domínio
  # que não esteja nesta lista, ou que carregue código de fora.
  #
  # Quando os inline saírem, tira-se o unsafe-inline e o CSP passa
  # a valer o dobro.
  #
  # O frame-src é 'none': o Stripe é um redirecionamento para o
  # site deles, não um iframe. Se um dia se usar o Stripe
  # Elements, tem de se abrir para js.stripe.com.
  # ------------------------------------------------------------
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://maps.googleapis.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://airportlink.onrender.com https://drivers.airportlink.app https://maps.googleapis.com https://www.google-analytics.com https://*.analytics.google.com; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'


# ------------------------------------------------------------
# OS FICHEIROS QUE NÃO MUDAM
#
# O CSS e o JavaScript têm ?v= no endereço, por isso o browser
# pode guardá-los para sempre — quando mudam, o endereço muda.
#
# Sem isto, cada visita descarrega 300 KB que já tinha.
# ------------------------------------------------------------

/assets/*
  Cache-Control: public, max-age=31536000, immutable


# As imagens também: o nome muda quando a imagem muda.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable


# ------------------------------------------------------------
# E O QUE MUDA
#
# As páginas geradas mudam quando o conteúdo muda, sem aviso no
# endereço. Uma hora de cache é o equilíbrio entre não pesar no
# servidor e não servir uma página velha durante um dia.
# ------------------------------------------------------------

/*.html
  Cache-Control: public, max-age=3600, must-revalidate


# O sitemap e o robots mudam a cada publicação.
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
