# ============================================================
# URLs LIMPOS
#
# Os ficheiros chamam-se login.html mas o URL público é /login.
# O código 200 é uma REESCRITA, não um redirecionamento: a barra de
# endereço continua a mostrar /login e o Google indexa um só URL.
# Com 301 aqui, cada página teria dois endereços e o SEO dividia-se.
# ============================================================

/                 /index.html            200
/drivers          /drivers.html          200
/travelagents     /travelagents.html     200
/myaccount        /myaccount.html        200
/support          /support.html          200
/login            /login.html            200
/createaccount    /createaccount.html    200
/success          /success.html          200
/privacypolicy    /privacypolicy.html    200
/terms            /terms.html            200

# Páginas de rota e de aeroporto, geradas por seo/build-routes.js.
# O :splat apanha tudo o que vier a seguir à barra.
/transfers/*      /transfers/:splat.html   200
/airports/*       /airports/:splat.html    200

# O /forgotpassword nunca foi construído: o formulário vive dentro
# do /login. Um 301 em vez de um 404 para quem tiver o link antigo.
#
# Havia aqui uma segunda regra a apontar para forgotpassword.html,
# que não existe. Duas regras para o mesmo caminho é sempre um erro:
# a primeira ganha e a segunda nunca corre, mas quem lê o ficheiro
# não sabe qual das duas está em vigor.
/forgotpassword   /login                 301

